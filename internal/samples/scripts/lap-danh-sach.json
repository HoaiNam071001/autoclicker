{
 "meta": {
  "name": "Lặp qua danh sách",
  "description": "Click vào ô gõ chữ, node Lặp qua danh sách đi qua 3 loại quả (mỗi dòng một phần tử), mỗi lượt gõ số thứ tự + tên rồi quay lại; hết danh sách thì kết thúc. Đúng: ô hiện “1. Táo; 2. Cam; 3. Xoài; ”, lời nhắn “Đã gõ 3 phần tử”. Đổi Danh sách sang File CSV / xlsx để thử dữ liệu của bạn.",
  "app": "Điều khiển",
  "level": 1,
  "page": "type.html",
  "real": false,
  "prep": "Trình duyệt mở to gần toàn màn hình (điểm click neo theo giữa màn hình)."
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/type.html",
    "delayAfter": 2500
   },
   {
    "type": "waitImage",
    "findBy": "text",
    "findText": "O GO CHU",
    "searchArea": "screen",
    "timeoutMs": 10000
   },
   {
    "type": "click",
    "points": [
     {
      "x": 0,
      "y": 0,
      "ax": "center",
      "ay": "center"
     }
    ],
    "delayAfter": 300
   },
   {
    "type": "forEach",
    "value": "Táo\nCam\nXoài"
   },
   {
    "type": "type",
    "text": "{{n4.output.index}}. {{n4.output.item}}; ",
    "delayAfter": 300
   },
   {
    "type": "end",
    "endStatus": "success",
    "message": "Đã gõ {{n4.output.count}} phần tử"
   }
  ],
  "edges": [
   {
    "from": "s1",
    "port": "success",
    "to": "s2"
   },
   {
    "from": "s2",
    "port": "success",
    "to": "s3"
   },
   {
    "from": "s3",
    "port": "success",
    "to": "s4"
   },
   {
    "from": "s4",
    "port": "item",
    "to": "s5"
   },
   {
    "from": "s5",
    "port": "success",
    "to": "s4"
   },
   {
    "from": "s4",
    "port": "done",
    "to": "s6"
   }
  ]
 }
}
