{
 "meta": {
  "name": "Click nhiều lần",
  "description": "Mở Bảng click, click trái 10 lần cách nhau 150 ms. Đúng: ô Click trái = 10, nhịp ≈ 150 ms.",
  "app": "Cơ bản",
  "level": 1,
  "page": "click.html",
  "real": false,
  "prep": "Trình duyệt mở to gần toàn màn hình (điểm click neo theo giữa màn hình)."
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/click.html",
    "delayAfter": 2500
   },
   {
    "type": "waitImage",
    "findBy": "text",
    "findText": "BANG CLICK",
    "textNoAccent": true,
    "searchArea": "screen",
    "timeoutMs": 10000
   },
   {
    "type": "click",
    "points": [
     {
      "x": 0,
      "y": 40,
      "ax": "center",
      "ay": "center"
     }
    ],
    "clicks": 10,
    "clickInterval": 150
   }
  ]
 }
}
