{
 "meta": {
  "name": "Phím tắt",
  "description": "Gõ hai dòng bằng Enter, bấm Tab, Shift+A, rồi gõ lần lượt X Y Z. Đúng: khung phím hiện Enter, Tab, Shift+A, X, Y, Z.",
  "app": "Cơ bản",
  "level": 1,
  "page": "type.html",
  "real": false,
  "prep": "Trình duyệt mở to gần toàn màn hình (điểm click neo theo giữa màn hình)."
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/type.html",
    "delayAfter": 2500
   },
   {
    "type": "waitImage",
    "findBy": "text",
    "findText": "O GO CHU",
    "textNoAccent": true,
    "searchArea": "screen",
    "timeoutMs": 10000
   },
   {
    "type": "click",
    "points": [
     {
      "x": 0,
      "y": 0,
      "ax": "center",
      "ay": "center"
     }
    ],
    "delayAfter": 300
   },
   {
    "type": "type",
    "text": "dòng một",
    "delayAfter": 200
   },
   {
    "type": "key",
    "keys": [
     "enter"
    ],
    "delayAfter": 200
   },
   {
    "type": "type",
    "text": "dòng hai",
    "delayAfter": 200
   },
   {
    "type": "key",
    "keys": [
     "tab"
    ],
    "delayAfter": 200
   },
   {
    "type": "key",
    "keys": [
     "a"
    ],
    "modifiers": [
     "shift"
    ],
    "delayAfter": 200
   },
   {
    "type": "key",
    "keys": [
     "x",
     "y",
     "z"
    ],
    "keyMode": "sequence"
   }
  ]
 }
}
