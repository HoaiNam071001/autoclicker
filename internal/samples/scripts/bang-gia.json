{
 "meta": {
  "name": "Bảng giá – chọn món rẻ",
  "description": "Ghép các node của bước 42 trên trang Bảng giá: Chờ màn hình (đứng yên 1 s) thay cho Chờ cố định lúc trang tải, Tìm tất cả lấy 6 nút THÊM, Lặp qua danh sách đi qua từng nút, Số & ngày lấy giá từ chữ của nút (“THÊM 15.000 đ” → 15000), Tính toán so với 30 000, Nếu rẻ thì click nút. Đúng: thanh trên hiện “ĐÃ CHỌN: 4 MÓN” (TÁO · CAM · XOÀI · CHUỐI), “TỔNG: 65.000 Đ”, ô Bấm lúc đang tải và Bấm lặp một món = 0. Đổi ngưỡng trong node Tính toán (vd <= 15000) để chọn ít món hơn – nhớ sửa chữ cần thấy ở node Chờ chữ cuối.",
  "app": "Điều khiển",
  "level": 2,
  "page": "price-list.html",
  "real": false
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/price-list.html",
    "delayAfter": 1500
   },
   {
    "type": "waitScreen",
    "stableMs": 1000,
    "diffPct": 1,
    "timeoutMs": 15000,
    "intervalMs": 200
   },
   {
    "type": "findAll",
    "findBy": "text",
    "findText": "THÊM",
    "searchArea": "screen",
    "minCount": 6,
    "timeoutMs": 10000
   },
   {
    "type": "forEach",
    "value": "{{n3.output.items}}"
   },
   {
    "type": "textNumber",
    "value": "{{n4.output.item.text}}"
   },
   {
    "type": "calc",
    "value": "{{n5.output.value}} <= 30000"
   },
   {
    "type": "if",
    "cond": {
     "kind": "value",
     "left": "{{n6.output.value}}",
     "op": "eq",
     "right": "true"
    }
   },
   {
    "type": "click",
    "points": [
     {
      "xVar": "{{n4.output.item.x}}",
      "yVar": "{{n4.output.item.y}}"
     }
    ],
    "delayAfter": 400
   },
   {
    "type": "waitImage",
    "findBy": "text",
    "findText": "ĐÃ CHỌN: 4 MÓN",
    "searchArea": "screen",
    "timeoutMs": 5000
   },
   {
    "type": "end",
    "endStatus": "success",
    "message": "Đã chọn các món ≤ 30.000 đ trong {{n4.output.count}} món"
   }
  ],
  "edges": [
   {
    "from": "s1",
    "port": "success",
    "to": "s2"
   },
   {
    "from": "s2",
    "port": "success",
    "to": "s3"
   },
   {
    "from": "s3",
    "port": "success",
    "to": "s4"
   },
   {
    "from": "s4",
    "port": "item",
    "to": "s5"
   },
   {
    "from": "s5",
    "port": "success",
    "to": "s6"
   },
   {
    "from": "s5",
    "port": "fail",
    "to": "s4"
   },
   {
    "from": "s6",
    "port": "success",
    "to": "s7"
   },
   {
    "from": "s7",
    "port": "true",
    "to": "s8"
   },
   {
    "from": "s7",
    "port": "false",
    "to": "s4"
   },
   {
    "from": "s8",
    "port": "success",
    "to": "s4"
   },
   {
    "from": "s4",
    "port": "done",
    "to": "s9"
   },
   {
    "from": "s9",
    "port": "success",
    "to": "s10"
   }
  ]
 }
}
