{
 "meta": {
  "name": "Web: cuộn trong khung + tới phần tử",
  "description": "Trang dài: lăn chuột thật trong dải cuộn ngang (cả trang không chạy), lăn tiếp tới khi thấy CỘT 12, rồi cuộn thẳng tới MỤC 30 và đọc dòng trạng thái góc dưới. Đúng: dải ngang ở cuối, trang dừng ở Mục 30, kết thúc báo “Đang xem: Mục 30”.",
  "app": "Web (DOM)",
  "level": 2,
  "page": "long.html",
  "real": false
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/long.html",
    "webBrowser": true,
    "delayAfter": 500
   },
   {
    "type": "webScroll",
    "scrollMode": "in",
    "selectors": [
     "css=#hscroll"
    ],
    "direction": "right",
    "amount": 5,
    "timeoutMs": 5000,
    "intervalMs": 200,
    "delayAfter": 300
   },
   {
    "type": "webScroll",
    "scrollMode": "until",
    "selectors": [
     "text=\"CỘT 12\""
    ],
    "scrollIn": [
     "css=#hscroll"
    ],
    "direction": "right",
    "amount": 3,
    "timeoutMs": 15000,
    "intervalMs": 300,
    "delayAfter": 300
   },
   {
    "type": "webScroll",
    "selectors": [
     "text=\"MỤC 30\""
    ],
    "timeoutMs": 5000,
    "intervalMs": 200,
    "delayAfter": 500
   },
   {
    "type": "webRead",
    "selectors": [
     "css=#now"
    ],
    "timeoutMs": 5000,
    "intervalMs": 200,
    "delayAfter": 0
   },
   {
    "type": "if",
    "cond": {
     "kind": "value",
     "left": "{{n5.output.text}}",
     "op": "contains",
     "right": "Mục 30"
    }
   },
   {
    "type": "end",
    "endStatus": "success",
    "message": "{{n5.output.text}}"
   },
   {
    "type": "end",
    "endStatus": "fail",
    "message": "Dòng trạng thái: {{n5.output.text}}"
   }
  ],
  "edges": [
   {
    "from": "s1",
    "port": "success",
    "to": "s2"
   },
   {
    "from": "s2",
    "port": "success",
    "to": "s3"
   },
   {
    "from": "s3",
    "port": "success",
    "to": "s4"
   },
   {
    "from": "s4",
    "port": "success",
    "to": "s5"
   },
   {
    "from": "s5",
    "port": "success",
    "to": "s6"
   },
   {
    "from": "s6",
    "port": "true",
    "to": "s7"
   },
   {
    "from": "s6",
    "port": "false",
    "to": "s8"
   }
  ]
 }
}
