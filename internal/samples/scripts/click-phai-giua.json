{
 "meta": {
  "name": "Click phải / click giữa",
  "description": "Click phải 3 lần rồi click giữa 2 lần trên Bảng click. Đúng: Click phải = 3, Click giữa = 2.",
  "app": "Cơ bản",
  "level": 1,
  "page": "click.html",
  "real": false,
  "prep": "Trình duyệt mở to gần toàn màn hình (điểm click neo theo giữa màn hình)."
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/click.html",
    "delayAfter": 2500
   },
   {
    "type": "waitImage",
    "findBy": "text",
    "findText": "BANG CLICK",
    "textNoAccent": true,
    "searchArea": "screen",
    "timeoutMs": 10000
   },
   {
    "type": "click",
    "points": [
     {
      "x": -150,
      "y": 40,
      "ax": "center",
      "ay": "center"
     }
    ],
    "button": "right",
    "clicks": 3,
    "clickInterval": 300
   },
   {
    "type": "click",
    "points": [
     {
      "x": 150,
      "y": 40,
      "ax": "center",
      "ay": "center"
     }
    ],
    "button": "center",
    "clicks": 2,
    "clickInterval": 300
   }
  ]
 }
}
