  "prep": "Trình duyệt mở to gần toàn màn hình (điểm click neo theo giữa màn hình)."
 },
 "script": {
  "steps": [
   {
    "type": "open",
    "target": "{{sandbox}}/click.html",
    "delayAfter": 2500
   },
   {
    "type": "waitImage",
    "findBy": "text",
    "findText": "BANG CLICK",
    "searchArea": "screen",
    "timeoutMs": 10000
   },
   {
    "type": "click",
    "points": [
     {
      "x": -150,
      "y": 40,
      "ax": "center",
      "ay": "center"
     }
    ],
    "delayAfter": 0
   },
   {
    "type": "wait",
    "delayAfter": 2000
   },
   {
    "type": "click",
    "points": [
     {
      "x": 0,
      "y": 40,
      "ax": "center",
      "ay": "center"
     }
    ],
    "delayAfter": 0
   },
   {
    "type": "wait",
    "delayAfter": 500,
    "jitterMs": 200
   },
   {
    "type": "click",
    "points": [
     {
      "x": 150,
      "y": 40,
      "ax": "center",
      "ay": "center"
     }
    ]
   }
  ]
 }
