{
  "version": 4,
  "name": "Facebook – trả lời tin nhắn gần nhất",
  "region": null,
  "loops": 1,
  "maxMinutes": 2,
  "start": "s1",
  "inputs": [
    { "key": "nguoi_nhan", "label": "Người nhận (username / id Facebook)", "type": "text", "default": "lan.nguyen", "required": true, "hint": "Phần sau facebook.com/ trên trang cá nhân, vd lan.nguyen hoặc 100012345678901" },
    { "key": "noi_dung", "label": "Nội dung trả lời", "type": "multiline", "default": "Ok, mình nhận được rồi nhé!", "required": true }
  ],
  "steps": [
    { "id": "s1", "ref": "n1", "type": "open", "name": "Mở khung chat với người nhận", "target": "https://www.facebook.com/messages/t/{{nguoi_nhan}}", "app": "Google Chrome", "delayAfter": 4000, "enabled": true },
    {
      "id": "s2", "ref": "n2", "type": "switchScreen", "name": "Trang đang ở đâu?", "timeoutMs": 8000, "intervalMs": 300, "enabled": true,
      "cases": [
        { "key": "pin", "label": "Hỏi mã PIN", "cond": { "kind": "any", "conds": [ { "kind": "text", "findText": "mã PIN", "searchArea": "screen" }, { "kind": "text", "findText": "Enter your PIN", "searchArea": "screen" } ] } },
        { "key": "login", "label": "Chưa đăng nhập", "cond": { "kind": "any", "conds": [ { "kind": "text", "findText": "Quên mật khẩu", "searchArea": "screen" }, { "kind": "text", "findText": "Forgot password", "searchArea": "screen" } ] } },
        { "key": "chat", "label": "Đã vào khung chat", "cond": { "kind": "text", "findText": "Aa", "textExact": true, "searchArea": "screen" } }
      ]
    },
    { "id": "s3", "ref": "n3", "type": "counter", "name": "Thử tải lại tối đa 2 lần", "max": 2, "enabled": true },
    { "id": "s4", "ref": "n4", "type": "key", "name": "Tải lại trang (F5)", "keys": ["f5"], "delayAfter": 4000, "enabled": true },
    { "id": "s5", "ref": "n5", "type": "end", "name": "Dừng: không mở được chat", "endStatus": "fail", "message": "Không mở được khung chat với {{nguoi_nhan}} sau {{n3.output.count}} lần tải lại", "enabled": true },
    { "id": "s6", "ref": "n6", "type": "end", "name": "Dừng: chưa đăng nhập", "endStatus": "fail", "message": "Chrome chưa đăng nhập Facebook – đăng nhập rồi chạy lại", "enabled": true },
    { "id": "s7", "ref": "n7", "type": "end", "name": "Dừng: hỏi mã PIN", "endStatus": "fail", "message": "Facebook hỏi mã PIN đoạn chat mã hoá – nhập tay một lần rồi chạy lại", "enabled": true },
    { "id": "s8", "ref": "n8", "type": "clickImage", "name": "Rê chuột lên tin gần nhất", "imageSource": "node", "imageFrom": "s2", "dx": -90, "dy": -60, "button": "left", "delayAfter": 600, "enabled": true },
    { "id": "s9", "ref": "n9", "type": "clickImage", "name": "Click icon Trả lời (cần khoanh ảnh mẫu)", "imageSource": "search", "template": "", "threshold": 85, "timeoutMs": 3000, "intervalMs": 250, "searchArea": "screen", "button": "left", "delayAfter": 500, "retry": { "count": 1, "delayMs": 500 }, "enabled": true },
    { "id": "s10", "ref": "n10", "type": "end", "name": "Dừng: không thấy icon Trả lời", "endStatus": "fail", "message": "Không thấy icon Trả lời – tin gần nhất có thể là tin của bạn, hoặc ảnh mẫu chưa khớp", "enabled": true },
    {
      "id": "s11", "ref": "n11", "type": "if", "name": "Đã vào chế độ trả lời?", "timeoutMs": 2000, "intervalMs": 250, "enabled": true,
      "cond": { "kind": "any", "conds": [ { "kind": "text", "findText": "Đang trả lời", "searchArea": "screen" }, { "kind": "text", "findText": "Replying to", "searchArea": "screen" } ] }
    },
    { "id": "s12", "ref": "n12", "type": "end", "name": "Dừng: chưa vào trả lời", "endStatus": "fail", "message": "Đã click nhưng không thấy dòng \"Đang trả lời\"", "enabled": true },
    { "id": "s13", "ref": "n13", "type": "type", "name": "Gõ nội dung trả lời", "text": "{{noi_dung}}", "delayAfter": 300, "enabled": true },
    { "id": "s14", "ref": "n14", "type": "key", "name": "Gửi (Enter)", "keys": ["enter"], "delayAfter": 1000, "enabled": true },
    { "id": "s15", "ref": "n15", "type": "end", "name": "Xong", "endStatus": "success", "message": "Đã trả lời tin nhắn gần nhất của {{nguoi_nhan}}", "enabled": true }
  ],
  "edges": [
    { "id": "e1", "from": "s1", "port": "success", "to": "s2" },
    { "id": "e2", "from": "s2", "port": "case:pin", "to": "s7" },
    { "id": "e3", "from": "s2", "port": "case:login", "to": "s6" },
    { "id": "e4", "from": "s2", "port": "case:chat", "to": "s8" },
    { "id": "e5", "from": "s2", "port": "none", "to": "s3" },
    { "id": "e6", "from": "s3", "port": "next", "to": "s4" },
    { "id": "e7", "from": "s3", "port": "done", "to": "s5" },
    { "id": "e8", "from": "s4", "port": "success", "to": "s2" },
    { "id": "e9", "from": "s8", "port": "success", "to": "s9" },
    { "id": "e10", "from": "s9", "port": "success", "to": "s11" },
    { "id": "e11", "from": "s9", "port": "fail", "to": "s10" },
    { "id": "e12", "from": "s11", "port": "true", "to": "s13" },
    { "id": "e13", "from": "s11", "port": "false", "to": "s12" },
    { "id": "e14", "from": "s13", "port": "success", "to": "s14" },
    { "id": "e15", "from": "s14", "port": "success", "to": "s15" }
  ]
}
